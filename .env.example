# =============================================================================
# ad-vit - environment template
# Copy to .env.local (apps) / .env (agent runtime). Never commit a filled copy.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (local stack: values printed by `npm run db:start`)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS - must never reach a browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Agent runtime
# -----------------------------------------------------------------------------
AGENT_RUNTIME_URL=http://127.0.0.1:8000

# Where an invitation link lands: the tenant web app's public origin. Read by
# the runtime (app/auth/invite.py) when the operator console creates an
# organisation for an owner who has no account yet. No default on purpose -
# unset, the runtime refuses to invite rather than compose a link to
# localhost. Production: https://ad-vit.broadmate.org
WEB_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Meta gateway
#
# fixture -> replays captured snapshots of the real ad accounts. The default:
#            deterministic, offline, and cannot spend money.
# graph   -> live Graph API. Requires the credentials below.
# adsmcp  -> reserved; not implemented.
# -----------------------------------------------------------------------------
META_DRIVER=fixture
META_API_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# The only ad account the graph driver may write to until explicitly widened.
# 1000000000000003 has no payment method, so even an accidental activation
# cannot spend. Funded accounts stay read-only.
META_WRITE_ALLOWLIST=1000000000000003

# -----------------------------------------------------------------------------
# Model routing (PRD 17.7 - profiles live in config/routing.yaml, not here)
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Optional direct Anthropic path for the Judgement tier, where OpenRouter does
# not expose adaptive thinking / effort control.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Observability (Langfuse self-hosted - founder decision D10)
# -----------------------------------------------------------------------------
LANGFUSE_HOST=http://127.0.0.1:3030
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_SERVICE_NAME=marketing-ai-os-agent-runtime

# -----------------------------------------------------------------------------
# Billing defaults. All configurable; none hard-coded in application logic.
# -----------------------------------------------------------------------------
# How long an owner has, after asking to pay an invoice, to send the money and
# quote the UTR / UPI reference. Read by the runtime (app/billing/payments.py).
PAYMENT_WINDOW_HOURS=4
DEFAULT_TRIAL_DAYS=14
DEFAULT_GRACE_DAYS=7
# Where the money goes. There is no gateway: the customer pays by UPI or NEFT
# against the invoice number and an operator matches the reference to the
# bank statement. These are the RUNTIME's variables, not the jobs process's -
# they are shown to a signed-in owner at request time. pay_to is null, and a
# payment request is refused with 503 before anything is written, until at
# least a UPI id OR the full bank triple (account name, number, IFSC) is set.
SELLER_UPI_ID=
SELLER_BANK_ACCOUNT_NAME=
SELLER_BANK_ACCOUNT_NUMBER=
SELLER_BANK_IFSC=
SELLER_BANK_NAME=
# Confirm the rate and SAC code with your CA before issuing a real invoice.
GST_RATE_PERCENT=18
GST_SAC_CODE=998314
SELLER_GSTIN=
SELLER_LEGAL_NAME=
SELLER_STATE_CODE=09
INVOICE_NUMBER_PREFIX=BMG

# -----------------------------------------------------------------------------
# Agent-runtime database credentials
#
# Created NOLOGIN by supabase/migrations/20260911000007_runtime_roles.sql; given
# local passwords by supabase/seeds/05_runtime_roles_local.sql, and production
# passwords by a Coolify pre-deploy step - a migration in git must not carry a
# secret.
#
# DATABASE_URL above is the SUPERUSER connection. It is kept for `supabase db
# reset` and the test suites' fixture setup and is read by no runtime code path;
# on it, RLS is not weakened, it is absent.
# -----------------------------------------------------------------------------
TENANT_DATABASE_URL=postgresql://advit_tenant:advit_tenant_local@127.0.0.1:54322/postgres
SERVICE_DATABASE_URL=postgresql://advit_service:advit_service_local@127.0.0.1:54322/postgres

# -----------------------------------------------------------------------------
# Supabase Auth
#
# The runtime verifies the JWT locally; GoTrue is never called per request.
# SUPABASE_JWKS_URL takes precedence when set, and SUPABASE_JWT_SECRET is the
# HS256 fallback. SUPABASE_JWT_SECRET_PREVIOUS gives an HMAC rotation a window
# in which both keys are accepted.
# -----------------------------------------------------------------------------
SUPABASE_JWT_SECRET=
SUPABASE_JWT_SECRET_PREVIOUS=
# The JWKS endpoint is what this deployment actually uses. `supabase status`
# still prints a JWT_SECRET and config.toml still has signing_keys_path
# commented out, but GoTrue is already issuing ES256 tokens with a `kid` -
# verified against the running stack. SUPABASE_JWT_SECRET below is the HS256
# fallback for a deployment that has not moved yet, and for the test suite,
# which has to mint tokens an auth server will not issue.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=

# -----------------------------------------------------------------------------
# Secret material at rest
#
# AES-256-GCM master key for core.org_secrets, which holds each customer's own
# OpenRouter key. Base64, 32 bytes decoded:
#
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#
# There is deliberately no fallback. Without this, storing a customer key
# raises rather than writing it in clear.
#
# Rotation: put the new key in ADVIT_SECRETS_MASTER_KEY_2 (or _3, ...), deploy,
# re-encrypt, then remove the old one. Rows carry the version that encrypted
# them, so both are readable meanwhile.
# -----------------------------------------------------------------------------
ADVIT_SECRETS_MASTER_KEY=
